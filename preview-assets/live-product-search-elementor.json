    "page_settings": {
        "custom_css": "/* Layout, colours, typography, padding and radius are native Elementor controls. */\n.juhani-search-result-card {--kit-widget-spacing:0px;min-width:0;touch-action:manipulation}\n.juhani-search-result-photo img {display:block;width:100%;height:100%;object-fit:cover}\n.juhani-search-result-copy {min-width:0}\n.juhani-search-result-price .woocommerce-Price-amount {white-space:nowrap}\n.juhani-search-result-price .woocommerce-Price-currencySymbol {font-size:11px;font-weight:500}\n.juhani-search-result-price .juhani-search-result-price-dash {color:#8fa4b3;font-weight:400;margin-inline:3px}\n.juhani-search-result-stock .juhani-search-result-stock-label {display:inline-flex;align-items:center;gap:5px;white-space:nowrap}\n.juhani-search-result-stock .juhani-search-result-stock-label:before {content:'';width:4px;height:4px;border-radius:50%;background:currentColor}\n.juhani-search-result-stock .is-unavailable {color:#9b6862}\n.juhani-search-result-card:focus-visible {outline:2px solid #236b9c;outline-offset:-3px}\n@media(max-width:767px) {.juhani-search-result-price .woocommerce-Price-currencySymbol {font-size:10px}}\n",
