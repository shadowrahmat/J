{
    "container": {
        "content_width": {
            "type": "select",
            "default": "boxed",
            "prefix_class": "e-con-"
        },
        "flex_items": {
            "type": "heading"
        },
        "flex__is_row": {
            "type": "hidden",
            "default": "row",
            "condition": {
                "flex_direction": [
                    "row",
                    "row-reverse"
                ],
                "container_type": [
                    "flex"
                ]
            }
        },
        "flex__is_column": {
            "type": "hidden",
            "default": "column",
            "condition": {
                "flex_direction": [
                    "",
                    "column",
                    "column-reverse"
                ],
                "container_type": [
                    "flex"
                ]
            }
        },
        "grid_items_grid": {
            "type": "heading"
        },
        "grid_outline": {
            "type": "switcher",
            "default": "yes",
            "condition": {
                "container_type": [
                    "grid"
                ]
            }
        },
        "grid__is_row": {
            "type": "hidden",
            "default": "row",
            "condition": {
                "grid_auto_flow": [
                    "row"
                ],
                "container_type": [
                    "grid"
                ]
            }
        },
        "grid__is_column": {
            "type": "hidden",
            "default": "column",
            "condition": {
                "grid_auto_flow": [
                    "column"
                ],
                "container_type": [
                    "grid"
                ]
            }
        },
        "background_color": {
            "type": "color",
            "default": "",
            "selectors": {
                "{{WRAPPER}}:not(.elementor-motion-effects-element-type-background), {{WRAPPER}} > .elementor-motion-effects-container > .elementor-motion-effects-layer": "background-color: {{VALUE}};"
            },
            "condition": {
                "background_background": [
                    "classic",
                    "gradient",
                    "video"
                ]
            }
        },
        "background_color_b": {
            "type": "color",
            "default": "#f2295b",
            "condition": {
                "background_background": [
                    "gradient"
                ]
            }
        },
        "background_hover_color": {
            "type": "color",
            "default": "",
            "selectors": {
                "{{WRAPPER}}:hover": "background-color: {{VALUE}};"
            },
            "condition": {
                "background_hover_background": [
                    "classic",
                    "gradient",
                    "video"
                ]
            }
        },
        "background_hover_color_b": {
            "type": "color",
            "default": "#f2295b",
            "condition": {
                "background_hover_background": [
                    "gradient"
                ]
            }
        },
        "background_overlay_color": {
            "type": "color",
            "default": "",
