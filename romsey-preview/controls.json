                "{{WRAPPER}}::before, {{WRAPPER}} > .elementor-background-video-container::before, {{WRAPPER}} > .e-con-inner > .elementor-background-video-container::before, {{WRAPPER}} > .elementor-background-slideshow::before, {{WRAPPER}} > .e-con-inner > .elementor-background-slideshow::before, {{WRAPPER}} > .elementor-motion-effects-container > .elementor-motion-effects-layer::before": "background-color: {{VALUE}};"
            },
            "condition": {
                "background_overlay_background": [
                    "classic",
                    "gradient",
                    "video"
                ]
            }
        },
        "background_overlay_color_b": {
            "type": "color",
